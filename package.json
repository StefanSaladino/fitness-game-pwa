{
  "name": "fitness-game-pwa",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.cjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "supabase:init": "supabase init",
    "db:test:ci": "node scripts/validate-db-ci.cjs",
    "validate": "npm run typecheck && npm test && npm run test:integration && npm run build && npm run db:test:ci",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "test:e2e:admin-layout": "playwright test --config playwright.admin.config.ts",
    "test:release": "npm run validate && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "supabase": "^2.0.0"
  }
}
