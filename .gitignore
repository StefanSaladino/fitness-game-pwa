# Dependencies / builds
node_modules/
dist/
coverage/
playwright-report/
test-results/
.internal-build/

# Netlify local CLI state
.netlify/

# Environment files and local secrets
# Commit only sanitized *.example templates.
.env
.env.*
!.env.example
!.env.*.example

# Common secret/key material
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks

# Supabase local/generated state (do not commit credentials/temp state)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*

# Temporary delivery artifacts — use Git history + canonical docs instead
/HANDOFF*.txt
/*-HANDOFF.txt
/*-PATCH-MANIFEST.txt
/*-PATCH-MANIFEST.md
/PATCH-FILES.txt
/PATCH-MANIFEST.md
/README-HOTFIX*
/README-PHASE*.txt
/README-PHASE*.md

# Logs / OS / editor noise
*.log
.DS_Store
Thumbs.db
.vscode/*.local.json
.idea/
