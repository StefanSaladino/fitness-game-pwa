# Fitness Game PWA — browser-safe environment template
#
# Copy this file to `.env.local` for local development:
#   macOS/Linux/Git Bash: cp .env.example .env.local
#   PowerShell:           Copy-Item .env.example .env.local
#
# HOSTED SUPABASE PROJECT
# Get both values from Supabase Dashboard -> Connect, or Settings -> API Keys.
# The publishable key is intended for browser/client use when RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional non-browser fallback for auth redirect URLs.
# Browser auth flows always use window.location.origin so production/preview
# users cannot be redirected to a stale localhost value baked into a deployment.
VITE_APP_URL=http://localhost:5173

# NEVER add any of these to a Vite/frontend env file:
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# POSTGRES_PASSWORD=
# NETLIFY_AUTH_TOKEN=
# Any value beginning with sb_secret_
