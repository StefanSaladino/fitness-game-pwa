# Fitness Game PWA — browser-safe environment template
#
# Copy this file to `.env.local` for local development:
#   macOS/Linux/Git Bash: cp .env.example .env.local
#   PowerShell:           Copy-Item .env.example .env.local
#
# HOSTED SUPABASE PROJECT
# Get both values from Supabase Dashboard -> Connect, or Settings -> API Keys.
# The publishable key is intended for browser/client use when RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional public-origin override used to construct auth redirect URLs.
# Local development can set this explicitly.
# Netlify deploy previews should normally OMIT VITE_APP_URL so the app uses
# window.location.origin and follows the exact preview origin automatically.
VITE_APP_URL=http://localhost:5173

# NEVER add any of these to a Vite/frontend env file:
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# POSTGRES_PASSWORD=
# NETLIFY_AUTH_TOKEN=
# NETLIFY_ACCESS_TOKEN=
# NETLIFY_ACCOUNT_ID=
# NETLIFY_SITE_ID=
# Any value beginning with sb_secret_
